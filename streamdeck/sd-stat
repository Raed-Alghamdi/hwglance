#!/bin/sh
# sd-stat cpu|gpu|ram|ssd : two short lines (label, values) for a Stream Deck key.
#
# hwglanced writes the two lines for each key every sample to
# $XDG_RUNTIME_DIR/hwglance/streamdeck/<key>.txt. This prints that file while it is younger
# than 5 s, which costs a shell and one `find` instead of a Python start (about 22 ms of CPU).
# When the file is missing or old (collector stopped, no reading), it runs sd-stat-fallback,
# which reads the summary file or the hardware itself. Keep both files in the same directory.

case $0 in
    */*) here=${0%/*} ;;
    *) here=. ;;
esac

case $1 in
    cpu|gpu|ram|ssd)
        dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hwglance/streamdeck
        f=$dir/$1.txt
        if [ -r "$f" ] && [ -n "$(find "$f" -newermt '5 seconds ago' 2>/dev/null)" ]; then
            if { IFS= read -r label && IFS= read -r values; } < "$f" && [ -n "$label" ] && [ -n "$values" ]; then
                printf '%s\n%s\n' "$label" "$values"
                exit 0
            fi
        fi
        ;;
esac

exec "$here/sd-stat-fallback" "$@"
