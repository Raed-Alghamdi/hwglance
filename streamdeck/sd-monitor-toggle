#!/bin/bash
# Toggle the HW Glance window (app id hwglance) on a monitor (Hyprland only).
# Opens maximized (bar visible) on that monitor's active workspace, without taking focus.
# Set HWGLANCE_MONITOR to a Hyprland monitor name (see `hyprctl monitors`), for example
# HWGLANCE_MONITOR=HDMI-A-1; by default the focused monitor is used.
export HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"
export PATH="/usr/bin:/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
MON="${HWGLANCE_MONITOR:-}"
APPID="hwglance"

# Discover the Hyprland instance when the environment does not carry it.
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
  # newest live instance whose socket answers
  for d in $(ls -dt "$XDG_RUNTIME_DIR"/hypr/*/ 2>/dev/null); do
    [ -S "${d}.socket.sock" ] || continue
    sig=$(basename "$d")
    if HYPRLAND_INSTANCE_SIGNATURE=$sig /usr/bin/hyprctl version >/dev/null 2>&1; then
      HYPRLAND_INSTANCE_SIGNATURE=$sig
      break
    fi
  done
  export HYPRLAND_INSTANCE_SIGNATURE
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
  for s in "$XDG_RUNTIME_DIR"/wayland-[0-9]; do
    [ -S "$s" ] && WAYLAND_DISPLAY=$(basename "$s")
  done
  export WAYLAND_DISPLAY
fi
[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || { echo "sd-monitor-toggle: Hyprland not found" >&2; exit 1; }

addr=$(hyprctl clients -j | jq -r --arg c "$APPID" '[.[]|select(.class==$c)][0].address // empty')
if [ -n "$addr" ]; then
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
  exit 0
fi

if [ -n "$MON" ]; then
  ws=$(hyprctl monitors -j | jq -r --arg m "$MON" '.[]|select(.name==$m)|.activeWorkspace.id')
else
  ws=$(hyprctl monitors -j | jq -r '[.[]|select(.focused)][0].activeWorkspace.id // empty')
fi
[ -n "$ws" ] || { echo "sd-monitor-toggle: monitor ${MON:-(focused)} not found" >&2; exit 1; }

# Make sure the collector is running; carry on even if it cannot be started.
systemctl --user is-active --quiet hwglanced || systemctl --user start hwglanced >/dev/null 2>&1 || true

cmd="$HOME/.local/bin/hwglance"
hyprctl dispatch "hl.dsp.exec_cmd(\"$cmd\", { workspace = \"$ws\", no_initial_focus = true })" >/dev/null

# Wait for the window to map, then maximize it (not true fullscreen) by address, which does not move focus.
for _ in $(seq 1 40); do
  addr=$(hyprctl clients -j | jq -r --arg c "$APPID" '[.[]|select(.class==$c)][0].address // empty')
  [ -n "$addr" ] && break
  sleep 0.1
done
[ -n "$addr" ] || exit 1
hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", window = \"address:$addr\" })" >/dev/null
exit 0
